{
  "hosting": {
    "public": "src",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/buscarCNPJ",    
        "function": "buscarCNPJ"
      },
      {
        "source": "**",
        "destination": "/pages/clients/consulta.html"
      }
    ]
  }
}
